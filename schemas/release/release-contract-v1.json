{
  "schema_version": "clroom.release-contract.v1",
  "policy": {
    "baseline": "latest_published_stable_github_release",
    "unclassified_delta": "fail",
    "changed_domain_without_disposition": "fail",
    "near_miss_without_disposition": "fail",
    "reviewed_content_drift": "fail",
    "changelog_action_time_relation": "declared_on_or_before_tag",
    "candidate_version_relation": "strictly_after_published_baseline",
    "changelog_date_floor": "published_baseline_date",
    "tag_remote_refresh_order": "after_pretag_stage_before_push",
    "runtime_rehearsal_phase": "exact_pr_candidate_before_merge_when_observable",
    "runtime_evidence_binding": "reviewed_content_digest_and_tree_plus_provider_inputs",
    "post_merge_runtime_role": "accepted_main_exact_shipping_byte_closure_before_tag",
    "codex_premerge_rehearsal_transport": "github_actions_macos_content_addressed_artifact",
    "claude_premerge_rehearsal_transport": "local_interactive_tty",
    "ambient_local_codex_release_input": "forbidden",
    "public_doc_version_inventory": {
      "active_globs": [
        "README.md",
        "SECURITY.md",
        "CONTRIBUTING.md",
        "GOVERNANCE.md",
        "CHANGELOG.md",
        "docs/**/*.md",
        "docs/**/*.txt",
        "docs/**/*.html",
        "docs/**/*.yml",
        "docs/**/*.yaml",
        "docs/**/*.xml",
        "docs/*.md",
        "docs/*.txt",
        "docs/*.html",
        "docs/*.yml",
        "docs/*.yaml",
        "docs/*.xml"
      ],
      "historical_exclusions": [
        "CHANGELOG.md"
      ],
      "historical_product_paths": [
        "SECURITY.md"
      ],
      "provider_version_source": "scripts/release/provider-pins.sh",
      "stale_or_unclassified_version": "fail",
      "allowed_noncurrent_provider_versions": {
        "codex": {
          "0.147.0": "minimum accepted Codex parser/runtime range"
        },
        "claude": {
          "2.1.223": "minimum accepted Claude parser/runtime range",
          "2.1.248": "Claude native --restricted availability floor"
        }
      },
      "allowed_other_versions": {}
    },
    "pretag_blocker_closure": "required",
    "codex_pretag_stage_transport": "github_actions_macos_accepted_main_exact_archive",
    "claude_pretag_stage_transport": "local_interactive_tty_exact_staged_archive",
    "provider_freshness_freeze": "accepted_main_pretag_stage",
    "post_tag_provider_latest_recheck": "forbidden",
    "post_tag_role": "tag_bound_attestation_exact_byte_promotion_and_reconciliation_only",
    "workflow_local_exec_contract": "direct_repo_local_scripts_require_executable_git_mode_or_explicit_interpreter",
    "pretag_promotion_prepare_rehearsal": "accepted_main_ubuntu_exact_resolver_invocation_required"
  },
  "domains": [
    {
      "id": "runtime",
      "patterns": [
        "src/**"
      ]
    },
    {
      "id": "tests",
      "patterns": [
        "tests/**",
        "fixtures/**",
        "fuzz/**",
        "scripts/probe/**"
      ]
    },
    {
      "id": "dependencies",
      "patterns": [
        "Cargo.toml",
        "Cargo.lock",
        "deny.toml"
      ]
    },
    {
      "id": "ci",
      "patterns": [
        ".github/workflows/**"
      ]
    },
    {
      "id": "release",
      "patterns": [
        "scripts/release/**",
        "packaging/**",
        "install.sh",
        "schemas/release/**",
        "reports/release/**"
      ]
    },
    {
      "id": "public_claims",
      "patterns": [
        "README.md",
        "SECURITY.md",
        "CHANGELOG.md",
        "docs/**",
        "CONTRIBUTING.md",
        "GOVERNANCE.md",
        "_config.yml",
        "robots.txt",
        "sitemap.xml",
        ".github/FUNDING.yml"
      ]
    }
  ],
  "domain_satisfying_dispositions": [
    "COVERED",
    "CONTRACT_EXPAND",
    "NOT_APPLICABLE"
  ],
  "near_miss_dispositions": [
    "COVERED",
    "CONTRACT_EXPAND",
    "NOT_APPLICABLE",
    "FOLLOW_UP"
  ],
  "contract_evolution_decisions": [
    "EXPAND",
    "NO_CHANGE"
  ]
}
